#!name=Phú Bôn - Locket Gold

[Script]
phubon_gold = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/fub0ln/phubon-locketgold/main/phubon-gold.js?v=1.4.1, requires-body=true, max-size=-1, timeout=10
phubon_request = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(?:receipts|subscribers\/[^/?]+)\/?(?:\?.*)?$, script-path=https://raw.githubusercontent.com/fub0ln/phubon-locketgold/main/phubon-request.js?v=1.1.0, timeout=10
phubon_full = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/fub0ln/phubon-locketgold/main/phubon-full-1.4.js?v=1.4.0, requires-body=true, max-size=-1, timeout=10

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com
